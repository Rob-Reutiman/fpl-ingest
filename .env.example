# FPL API
FPL_BASE_URL=https://fantasy.premierleague.com/api

# Local DuckDB path
DB_PATH=data/fpl.duckdb

# Your own FPL manager ID
MY_MANAGER_ID=

# HTTP client tunables
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=0.2
RETRY_ATTEMPTS=3

# Cohort sampling
COHORT_SAMPLE_SIZE=10000
COHORT_TOP_SLICE=5000
COHORT_RANDOM_SLICE=5000
